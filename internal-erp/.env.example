# 复制为 internal-erp/.env。切勿提交真实令牌或私钥。
ERP_DB_URL=jdbc:postgresql://127.0.0.1:5432/internal_erp
ERP_DB_USERNAME=postgres
ERP_DB_PASSWORD=YOUR_POSTGRES_PASSWORD
ERP_SERVICE_TOKEN=YOUR_ERP_SERVICE_TOKEN

# 仅配置公钥。私钥留在 my-agent 或密钥服务中。
ERP_MCP_JWT_PUBLIC_KEY=YOUR_ERP_MCP_JWT_PUBLIC_KEY_BASE64
ERP_MCP_JWT_ISSUER=my-agent
ERP_MCP_JWT_AUDIENCE=internal-erp
