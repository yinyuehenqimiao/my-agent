# 本机环境变量模板。复制为 .env 后填写至少一种模型平台的 API Key。
SILICONFLOW_API_KEY=
BAILIAN_API_KEY=
SA_TOKEN_JWT_SECRET_KEY=replace-with-a-long-random-secret-in-production

# SiliconFlow 示例
AGENT_CHAT_PROVIDER=siliconflow
AGENT_CHAT_MODEL=deepseek-ai/DeepSeek-V3
AI_CHAT_PROVIDER=siliconflow
AI_CHAT_MODEL=deepseek-ai/DeepSeek-V3
AI_EMBEDDING_PROVIDER=siliconflow
AI_EMBEDDING_MODEL=BAAI/bge-m3

# 若使用百炼，填写 BAILIAN_API_KEY 并改为：
# AGENT_CHAT_PROVIDER=bailian
# AGENT_CHAT_MODEL=qwen-plus
# AI_CHAT_PROVIDER=bailian
# AI_CHAT_MODEL=qwen-plus
# AI_EMBEDDING_PROVIDER=bailian
# AI_EMBEDDING_MODEL=text-embedding-v4

SPRING_DATASOURCE_URL=jdbc:postgresql://127.0.0.1:5432/myagent?client_encoding=UTF8
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=postgres
SPRING_DATA_REDIS_HOST=127.0.0.1
SPRING_DATA_REDIS_PORT=6379
SPRING_DATA_REDIS_PASSWORD=123456
ROCKETMQ_NAME_SERVER=127.0.0.1:9876
RAG_STORAGE_S3_ENDPOINT=http://127.0.0.1:9000
RAG_STORAGE_S3_ACCESS_KEY=rustfsadmin
RAG_STORAGE_S3_SECRET_KEY=rustfsadmin

# 请假引擎：flowable=新工作流；legacy=旧企业逻辑
# MYAGENT_ENTERPRISE_LEAVE_ENGINE=flowable
