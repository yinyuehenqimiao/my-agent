# 复制本文件为 .env 后填写真实值。切勿把真实密钥提交到 Git。
# 本地演示中间件的默认值见 deploy/docker-compose.yml 顶部注释。

# ---- 模型平台（至少填写一种）----
SILICONFLOW_API_KEY=YOUR_SILICONFLOW_API_KEY
BAILIAN_API_KEY=YOUR_BAILIAN_API_KEY

# 生产环境必须换成高强度随机串，不要使用仓库中的占位符。
SA_TOKEN_JWT_SECRET_KEY=YOUR_JWT_SECRET_CHANGE_ME

# SiliconFlow 示例
AGENT_CHAT_PROVIDER=siliconflow
AGENT_CHAT_MODEL=deepseek-ai/DeepSeek-V3
AI_CHAT_PROVIDER=siliconflow
AI_CHAT_MODEL=deepseek-ai/DeepSeek-V3
AI_EMBEDDING_PROVIDER=siliconflow
AI_EMBEDDING_MODEL=BAAI/bge-m3

# 若使用阿里云百炼，填写 BAILIAN_API_KEY 并改为：
# AGENT_CHAT_PROVIDER=bailian
# AGENT_CHAT_MODEL=qwen-plus
# AI_CHAT_PROVIDER=bailian
# AI_CHAT_MODEL=qwen-plus
# AI_EMBEDDING_PROVIDER=bailian
# AI_EMBEDDING_MODEL=text-embedding-v4

# ---- 数据存储 ----
SPRING_DATASOURCE_URL=jdbc:postgresql://127.0.0.1:5432/myagent?client_encoding=UTF8
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=YOUR_POSTGRES_PASSWORD
SPRING_DATA_REDIS_HOST=127.0.0.1
SPRING_DATA_REDIS_PORT=6379
SPRING_DATA_REDIS_PASSWORD=YOUR_REDIS_PASSWORD
ROCKETMQ_NAME_SERVER=127.0.0.1:9876
RAG_STORAGE_S3_ENDPOINT=http://127.0.0.1:9000
RAG_STORAGE_S3_ACCESS_KEY=YOUR_S3_ACCESS_KEY
RAG_STORAGE_S3_SECRET_KEY=YOUR_S3_SECRET_KEY

# 可选：You.com 联网检索
YDC_API_KEY=YOUR_YDC_API_KEY

# ---- 可选：对接独立 ERP（internal-erp）----
# LOCAL=内置企业表演示；HTTP_ERP=调用独立 ERP 服务
ENTERPRISE_ADAPTER=LOCAL
ERP_BASE_URL=http://127.0.0.1:18081
ERP_SERVICE_TOKEN=YOUR_ERP_SERVICE_TOKEN
ERP_TIMEOUT_MS=3000

# MCP 调用 ERP 时使用的 RS256 密钥对（PEM 去掉头尾后的 Base64）。
# 生成示例：
#   openssl genrsa -out erp-mcp-private.pem 2048
#   openssl rsa -in erp-mcp-private.pem -pubout -out erp-mcp-public.pem
ERP_MCP_JWT_PRIVATE_KEY=YOUR_ERP_MCP_JWT_PRIVATE_KEY_BASE64
ERP_MCP_JWT_PUBLIC_KEY=YOUR_ERP_MCP_JWT_PUBLIC_KEY_BASE64
ERP_MCP_JWT_ISSUER=my-agent
ERP_MCP_JWT_AUDIENCE=internal-erp

# 管理端发现 MCP 工具时解析 secretRef=vault:erp 所用的短时令牌
MCP_DISCOVERY_TOKEN_VAULT_ERP=YOUR_MCP_DISCOVERY_TOKEN

# 请假引擎：flowable=动态工作流；legacy=旧企业逻辑
# MYAGENT_ENTERPRISE_LEAVE_ENGINE=flowable
